{
  "name": "study-app",
  "private": true,
  "version": "0.0.0",
  "author": "David Power <david2power@gmail.com>",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "preelectron:build": "npm run build",
    "electron:build": "electron-builder --linux"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.studyapp.app",
    "productName": "Study App",
    "files": [
      "dist/**/*",
      "electron.js"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Utility"
    }
  }
}